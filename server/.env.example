# Server Port (Render sets this automatically, default: 5000)
PORT=5000

# MongoDB Connection String (e.g. MongoDB Atlas URI)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/chat_auth_db

# Secret key for JWT signing
JWT_SECRET=your_jwt_secret_here

# Client Frontend URL (or comma-separated URLs for multi-domain setup)
CLIENT_URL=http://localhost:3000
